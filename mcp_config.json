{
  "mcpServers": {
    "viber": {
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--directory",
        "${PLUGIN_ROOT}",
        "server.py"
      ],
      "env": {
        "PLUGIN_ROOT": "${PLUGIN_ROOT}",
        "VIBER_MCP_AUTO_UPDATE": "true",
        "VIBER_MCP_AUTO_START": "true"
      }
    }
  }
}
